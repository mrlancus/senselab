    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@senselab/shared": "workspace:*",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^22.19.0",
    "wrangler": "^4.151.2"
  }
}
